{
  "description": "项目配置文件",
  "miniprogramRoot": "miniprogram/",
  "cloudfunctionRoot": "cloudfunctions/",
  "compileType": "miniprogram",
  "setting": {
    "useCompilerPlugins": [
      "typescript"
    ],
    "swc": false,
    "disableSWC": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    },
    "coverView": false,
    "postcss": false,
    "minified": true,
    "enhance": false,
    "showShadowRootInWxmlPanel": false,
    "packNpmRelationList": [],
    "ignoreUploadUnusedFiles": false,
    "ignoreDevUnusedFiles": false,
    "bigPackageSizeSupport": true,
    "compileHotReLoad": false,
    "skylineRenderEnable": true,
    "es6": true,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "packNpmManually": false,
    "minifyWXSS": true,
    "localPlugins": false,
    "condition": false,
    "compileWorklet": false,
    "disableUseStrict": false,
    "minifyWXML": true
  },
  "simulatorType": "wechat",
  "simulatorPluginLibVersion": {},
  "condition": {},
  "srcMiniprogramRoot": "miniprogram/",
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  },
  "libVersion": "trial",
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "assets/materials" },
      { "type": "folder", "value": "assets/editorial" },
      { "type": "folder", "value": "assets/flowers" },
      { "type": "folder", "value": "assets/probe" },
      { "type": "folder", "value": "packages" }
    ],
    "include": [
      { "type": "folder", "value": "assets/materials-ui" }
    ]
  },
  "appid": "touristappid"
}
