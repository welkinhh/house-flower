.admin-card { display: flex; min-height: 108rpx; flex-direction: column; justify-content: space-between; padding: 18rpx; border: 1rpx solid #ecddd4; border-radius: 12rpx; background: #fffdf9; color: #8c756b; font-size: 19rpx; }
.admin-number { color: #724038; font-family: Georgia, serif; font-size: 38rpx; }
.admin-section { margin-top: 18rpx; padding: 18rpx; border: 1rpx solid #ecddd4; border-radius: 12rpx; background: #fffdf9; }
