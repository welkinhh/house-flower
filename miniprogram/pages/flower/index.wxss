.admin-scroll { flex: 1; overflow-y: auto; padding-bottom: 30rpx; }
.admin-gift-card { display: flex; flex-direction: column; gap: 14rpx; margin-bottom: 18rpx; padding: 20rpx; border: 1rpx solid #e8d8cd; border-radius: 14rpx; background: #fffdf9; }
