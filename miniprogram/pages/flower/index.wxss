/* WeChat's style-v2 button skin sets a fixed 184px width and auto margins.
   Scope a reset to this app shell, then explicitly size the controls whose
   layout depends on their card, grid or icon dimensions. */
.app-shell button {
  box-sizing: border-box;
  min-width: 0;
  max-width: 100%;
  margin-left: 0;
  margin-right: 0;
  width: auto;
}

