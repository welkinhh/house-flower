}

.bn-swiper {
  width: 100%;
  height: 100%;
}

.bn {
  position: relative;
  width: 100%;
  height: 100%;
}

.bn image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.bn-veil {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(38, 30, 24, 0.6), rgba(38, 30, 24, 0.1) 44%, rgba(38, 30, 24, 0) 68%);
}

