.app-shell button.nav-item { width: auto; }
.app-shell button.avatar-button { width: 88rpx; }
.app-shell button.settings-avatar { width: 160rpx; }
.app-shell button.scene-chip { width: 48%; }
.app-shell button.scene-option { width: auto; flex: 1 1 0; }
.app-shell button.step-btn { width: 36rpx; }
.app-shell button.row-delete { width: 24rpx; }
