.contact-copy { flex: 1 1 auto; min-width: 0; text-align: left; }
.contact-label { display: block; color: #a08c7e; font-size: 20rpx; }
.contact-value { display: block; color: #4a3a32; font-size: 26rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.contact-cta { flex: 0 0 auto; color: #bd7d7d; font-size: 24rpx; font-weight: 600; }

/* ===== 品牌设置 ===== */
.editor-field-area { flex-direction: column; align-items: stretch; }
.editor-field-area textarea { width: 100%; min-height: 120rpx; margin-top: 10rpx; padding: 16rpx; border: 1rpx solid #e7d8cc; border-radius: 14rpx; font-size: 26rpx; background: #fbf7f2; }
