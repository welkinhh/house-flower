/* ---------------- 作品详情 ---------------- */
.work-detail-screen { padding-top: 4rpx; }

.detail-scroll {
  min-height: 0;
  flex: 1 1 auto;
}

.detail-heading {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 76rpx 20rpx 6rpx;
}
.detail-more { position: absolute; top: 12rpx; right: 0; width: 64rpx; height: 64rpx; border: 1rpx solid #e8dcd2; border-radius: 50%; color: #95796d; font-size: 26rpx; line-height: 1; }

.detail-heading .detail-sub {
  color: #b3a497;
  font-size: 21rpx;
}

.saved-materials { margin-top: 8rpx; }

/* ---------------- 底部导航：紧凑贴合底部 ---------------- */
.bottom-nav {
  display: flex;
  box-sizing: border-box;
  width: calc(100% + 64rpx);
  height: calc(70rpx + env(safe-area-inset-bottom));
  flex: 0 0 calc(70rpx + env(safe-area-inset-bottom));
  align-items: stretch;
  justify-content: space-between;
  margin: 0 -32rpx;
  padding: 0 32rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid #e9dfd4;
  background: rgba(250, 247, 241, 0.97);
}

.nav-item {
  position: relative;
  top: 6rpx;
  display: flex;
  min-width: 0;
  min-height: 66rpx;
  flex: 1 1 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  color: #b3a497;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.nav-item.active { color: #8a5f5b; }

.nav-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  color: currentColor;
}

.nav-home::before {
  position: absolute;
  top: 16rpx;
  left: 7rpx;
  width: 27rpx;
  height: 22rpx;
  border: 2rpx solid currentColor;
  border-top: 0;
  border-radius: 3rpx 3rpx 5rpx 5rpx;
  content: "";
}
.nav-home::after {
  position: absolute;
  top: 6rpx;
  left: 11rpx;
  width: 20rpx;
  height: 20rpx;
  border-top: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}

.nav-inspiration::before {
  position: absolute;
  top: -1rpx;
  left: 2rpx;
  content: "☆";
  font-family: Arial, sans-serif;
  font-size: 34rpx;
  line-height: 40rpx;
}

.nav-inspiration::after {
  position: absolute;
  right: 1rpx;
  bottom: 1rpx;
  content: "☆";
  font-family: Arial, sans-serif;
  font-size: 20rpx;
  line-height: 24rpx;
}

.nav-works::before {
  position: absolute;
  top: 5rpx;
  left: 8rpx;
  width: 27rpx;
  height: 32rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
  content: "";
}
.nav-works::after {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 15rpx;
  border-left: 2rpx solid currentColor;
  content: "";
}

/* ---------------- 导出画布（隐藏） ---------------- */
.export-canvas {
  position: fixed;
  top: -3000rpx;
  left: -3000rpx;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

/* ---------------- 小屏适配 ---------------- */
@media (max-height: 700px) {
  .home-screen { padding-top: calc(env(safe-area-inset-top) + 24rpx); }
  .hero-slogan { font-size: 44rpx; }
  .hcard-frame { height: 0; padding-bottom: 100%; }
  .hero-image,.hero-image.tall,.hero-image.square-output { height: calc(100vw - 32px); }
  .upload-card { min-height: 300rpx; }
  .bn-wrap { height: 250rpx; flex-basis: 250rpx; }
  .wf-img-frame { height: 0; padding-bottom: 100%; }
  .work-image-wrap { height: 0; padding-bottom: 100%; }
}


@media (max-width: 360px) {
  .material-row,.material-head { grid-template-columns: 52rpx minmax(70rpx, 1fr) minmax(58rpx, .8fr) minmax(176rpx, auto); column-gap: 5rpx; }
  .material-thumb { width: 48rpx; height: 58rpx; flex-basis: 48rpx; }
  .step-btn { width: 34rpx; flex-basis: 34rpx; }
  .step-num { min-width: 96rpx; max-width: 120rpx; font-size: 16rpx; }
  .row-delete { width: 22rpx; flex-basis: 22rpx; }
  .select-count { min-width: 90rpx; font-size: 20rpx; }
  .select-actions .link-button,.select-actions .delete-button { min-width: 90rpx; padding: 0 10rpx; font-size: 20rpx; }
}

