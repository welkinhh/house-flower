/* ==========================================================
   House花生 · 页面样式
   视觉体系参照「花作」UI 参考图 + v6t.html 原型：
   奶油底色 / 玫瑰粉主色 / 衬线标题 / 圆角卡片 / 充分留白
   ========================================================== */

page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #f6f1ea;
  color: #3b342e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Songti SC", "Noto Serif SC", serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: 1.4;
}
button::after { border: 0; }

.app-shell {
  position: relative;
  box-sizing: border-box;
  display: flex;
  width: 100%;
  height: 100vh;
  min-height: 0;
  flex-direction: column;
  overflow: hidden;
  padding: 0 32rpx;
  background: #f6f1ea;
}

/* ---------------- 顶部导航 ---------------- */
.topbar {
  position: relative;
  display: flex;
  flex: 0 0 104rpx;
  align-items: center;
  justify-content: center;
}

.page-title {
  color: #3b342e;
  font: 32rpx "Songti SC", "Noto Serif SC", serif;
  letter-spacing: 3rpx;
}

.back-button {
  position: absolute;
  z-index: 5;
  top: 0;
  bottom: 0;
  left: -28rpx;
  display: flex;
  width: 72rpx;
  align-items: center;
  justify-content: center;
}

.icon-back {
  width: 20rpx;
  height: 20rpx;
  border-bottom: 3rpx solid #3b342e;
  border-left: 3rpx solid #3b342e;
  transform: rotate(45deg);
}

/* ---------------- 通用屏幕容器 ---------------- */
.screen {
  display: flex;
  min-height: 0;
  flex: 1;
  flex-direction: column;
  overflow: hidden;
  padding: 12rpx 0 20rpx;
}

.scroll-area {
  display: flex;
  min-height: 0;
  flex: 1;
  flex-direction: column;
  overflow-y: auto;
  padding: 12rpx 0 24rpx;
}

.copy-block {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 14rpx;
  padding: 8rpx 4rpx 26rpx;
}

.copy-block.slim { padding: 4rpx 4rpx 20rpx; }

.screen-heading {
  display: flex;
  flex-direction: column;
  color: #3b342e;
  font: 46rpx/1.4 "Songti SC", "Noto Serif SC", serif;
  letter-spacing: 2rpx;
}

.screen-desc {
  color: #9a8b7e;
  font: 24rpx/1.6 "Songti SC", serif;
}

.screen-desc.strong {
  color: #4c4239;
  font-size: 30rpx;
  letter-spacing: 1rpx;
}

.section-head {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  margin-bottom: 14rpx;
}

.section-title {
  color: #4c4239;
  font: 27rpx "Songti SC", serif;
  letter-spacing: 1rpx;
}

.section-note {
  color: #b3a497;
  font-size: 21rpx;
}

.link-button {
  color: #a96663;
  font-size: 22rpx;
}

.status-message {
  display: block;
  flex: 0 0 auto;
  padding: 8rpx 4rpx;
  color: #a96663;
  font-size: 22rpx;
}

.recognition-unavailable-note {
  display: block;
  flex: 0 0 auto;
  padding: 4rpx;
  color: #9a8b7e;
  font-size: 19rpx;
  text-align: center;
}

/* ---------------- 通用按钮 ---------------- */
.btn {
  display: flex;
  min-height: 88rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0 24rpx;
  border-radius: 44rpx;
  font: 28rpx "Songti SC", serif;
  letter-spacing: 2rpx;
}

.btn.primary {
  background: #bd7d7d;
  color: #fffdf9;
  box-shadow: 0 10rpx 24rpx rgba(166, 102, 101, 0.22);
}

.btn.primary[disabled] {
  opacity: 1;
  background: #ead8d0;
  color: #8c6b61;
  box-shadow: none;
}
.btn.primary.progress-action.is-generating[disabled] {
  opacity: 1;
  background: #bd7d7d;
  color: #fffdf9;
  box-shadow: 0 10rpx 24rpx rgba(166, 102, 101, 0.22);
}

.btn.outline {
  border: 1rpx solid #dcccbd;
  background: #fffdf9;
  color: #6b5f55;
}

.bottom-action {
  flex: 0 0 88rpx;
  margin-top: 18rpx;
  font-size: 30rpx;
}

/* The canonical full-screen result rules follow below. */
.icon-arrow {
  font-size: 30rpx;
  line-height: 1;
}

.link-save {
  flex: 0 0 auto;
  margin-top: 18rpx;
  color: #a96663;
  font-size: 24rpx;
  text-align: center;
}

/* ---------------- 生花成品：沉浸式图面与左下信息卡 ---------------- */
.generated-screen {
  position: relative;
  min-height: 0;
  flex: 1;
  margin: 0 -32rpx;
  padding: 0;
  overflow: hidden;
  background: #000;
}

.generated-full-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: #000;
}

.generated-top-actions {
  position: absolute;
  z-index: 3;
  top: 18rpx;
  right: 24rpx;
  left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  pointer-events: none;
}

.result-icon-button {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  flex: 0 0 62rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 253, 249, .86);
  border-radius: 50%;
  background: rgba(255, 253, 249, .86);
  color: #51473f;
  pointer-events: auto;
  box-shadow: 0 4rpx 14rpx rgba(48, 43, 39, .1);
}

.result-icon-button .icon-back {
  width: 18rpx;
  height: 18rpx;
  transform: translateX(3rpx) rotate(45deg);
}

.download-glyph {
  font: 34rpx/1 Georgia, serif;
}

.generated-demo-tag {
  position: absolute;
  z-index: 2;
  top: 94rpx;
  right: 24rpx;
  padding: 6rpx 14rpx;
  border-radius: 24rpx;
  background: rgba(255, 253, 249, .86);
  color: #9a756c;
  font-size: 18rpx;
}

.generated-info-card {
  position: absolute;
  z-index: 2;
  right: 24rpx;
  bottom: 118rpx;
  left: 24rpx;
  display: flex;
  min-height: 126rpx;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(236, 226, 214, .92);
  border-radius: 18rpx;
  background: rgba(255, 253, 249, .94);
  box-shadow: 0 10rpx 30rpx rgba(48, 43, 39, .12);
}

.generated-source-thumb {
  width: 116rpx;
  height: 116rpx;
  flex: 0 0 116rpx;
  border-radius: 12rpx;
  background: #f1e9e0;
}

.generated-info-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 7rpx;
}

.generated-name-input {
  width: 100%;
  overflow: hidden;
  color: #3b342e;
  font: 27rpx "Songti SC", serif;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.generated-date {
  color: #a3948a;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.generated-action-row {
  position: absolute;
  z-index: 3;
  right: 20rpx;
  bottom: calc(14rpx + env(safe-area-inset-bottom));
  left: 20rpx;
  display: flex;
  gap: 12rpx;
}

.generated-action-row .btn {
  min-width: 0;
  min-height: 80rpx;
  padding: 0 12rpx;
  font-size: 22rpx;
  letter-spacing: 0;
}

.save-icon {
  position: relative;
  width: 22rpx;
  height: 18rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  border-radius: 0 0 4rpx 4rpx;
}
.save-icon::before {
  position: absolute;
  top: -5rpx;
  left: 9rpx;
  width: 2rpx;
  height: 12rpx;
  background: currentColor;
  content: "";
}
.save-icon::after {
  position: absolute;
  top: 2rpx;
  left: 5rpx;
  width: 9rpx;
  height: 9rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}

.action-row {
  display: flex;
  flex: 0 0 auto;
  gap: 16rpx;
  margin-top: 22rpx;
}

/* ---------------- 1. 首页（整屏铺满） ---------------- */
.home-screen {
  position: relative;
  display: flex;
  min-height: 0;
  flex: 1;
  flex-direction: column;
  margin: 0 -32rpx;
  padding: calc(env(safe-area-inset-top) + 30rpx) 0 12rpx;
}

.home-bg,
.home-veil {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.home-veil {
  background: linear-gradient(180deg, rgba(246, 241, 234, 0.5), rgba(246, 241, 234, 0.06) 40%, rgba(246, 241, 234, 0.93));
}

.home-image-status {
  position: absolute;
  z-index: 1;
  top: 52%;
  right: 32rpx;
  left: 32rpx;
  color: #8a7c6f;
  font-size: 22rpx;
  text-align: center;
}

.hero-head {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 22rpx;
  padding: 0 32rpx;
}

.hero-brand {
  color: #3b342e;
  font: 30rpx Georgia, "Songti SC", serif;
  letter-spacing: 2rpx;
}

.hero-settings {
  position: absolute;
  top: -8rpx;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 50%;
  background: rgba(255, 250, 243, 0.7);
  color: #6f6259;
  font-size: 30rpx;
  line-height: 64rpx;
}

.hero-settings::after { border: none; }

.hero-slogan {
  display: flex;
  max-width: 460rpx;
  flex-direction: column;
  color: #3b342e;
  font: 50rpx/1.55 "Songti SC", "Noto Serif SC", serif;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 14rpx rgba(255, 253, 249, 0.6);
}

.hero-en {
  max-width: 180rpx;
  padding-top: 8rpx;
  color: #b9a99c;
  font: italic 22rpx/1.6 Georgia, serif;
  text-align: right;
}

.home-entries {
  position: relative;
  z-index: 1;
  display: grid;
  box-sizing: border-box;
  width: 100%;
  max-width: 760rpx;
  flex: 0 0 auto;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  justify-items: stretch;
  gap: 16rpx;
  margin-top: auto;
  margin-right: auto;
  margin-left: auto;
  padding: 26rpx 32rpx 12rpx;
}

.hcard {
  position: relative;
  box-sizing: border-box;
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  padding: 10rpx 10rpx 12rpx;
  overflow: hidden;
  border: 1rpx solid #ece2d6;
  border-radius: 20rpx;
  background: #fffdf9;
  text-align: left;
  box-shadow: 0 10rpx 26rpx rgba(88, 64, 52, 0.12);
}

.hcard-frame {
  position: relative;
  width: 100%;
  height: 0;
  flex: 0 0 auto;
  padding-bottom: 100%;
  overflow: hidden;
  border-radius: 14rpx;
  background: #f1e9e0;
}
.hcard-frame image { position: absolute; inset: 0; width: 100%; height: 100%; }

.hcard-copy {
  display: flex;
  min-width: 0;
  flex: 0 0 auto;
  flex-direction: column;
  gap: 4rpx;
  overflow: hidden;
  margin-top: 10rpx;
}

.hcard-title {
  display: block;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  color: #3b342e;
  font: 24rpx "Songti SC", serif;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 普通块级两行截断（不用 -webkit-box，避免最小宽度撑爆列宽） */
.hcard-note {
  display: block;
  width: 100%;
  max-height: 50rpx;
  overflow: hidden;
  color: #a3948a;
  font-size: 18rpx;
  line-height: 25rpx;
  word-break: break-all;
}

.hcard-arrow {
  align-self: flex-end;
  width: 36rpx;
  height: 36rpx;
  margin-top: 6rpx;
  border: 1rpx solid #d9bcb6;
  border-radius: 50%;
  color: #bd7d7d;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
}

/* ---------------- 上传卡片 ---------------- */
.upload-card {
  position: relative;
  display: flex;
  min-height: 350rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid #e5d9cc;
  border-radius: 24rpx;
  background: #fbf7f1;
  box-shadow: 0 8rpx 22rpx rgba(88, 64, 52, 0.05);
}

.upload-card.has-image { border-style: solid; }

.upload-photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: #f1e9e0;
}

.upload-empty {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  color: #8a7c6f;
}

.photo-upload-icon {
  position: relative;
  display: flex;
  width: 100rpx;
  height: 100rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #cbbdaf;
  border-radius: 22rpx;
  background: #fffdf9;
}

.photo-icon-sun {
  position: absolute;
  top: 22rpx;
  right: 24rpx;
  width: 11rpx;
  height: 11rpx;
  border: 2rpx solid #9b8c80;
  border-radius: 50%;
}

.photo-icon-mountain {
  position: absolute;
  bottom: 24rpx;
  left: 22rpx;
  width: 43rpx;
  height: 31rpx;
  overflow: hidden;
  border: 2rpx solid #9b8c80;
  border-radius: 5rpx;
}

.photo-icon-mountain::before,
.photo-icon-mountain::after {
  position: absolute;
  bottom: -10rpx;
  width: 23rpx;
  height: 23rpx;
  border-top: 2rpx solid #9b8c80;
  border-left: 2rpx solid #9b8c80;
  content: "";
  transform: rotate(45deg);
}

.photo-icon-mountain::before { left: 3rpx; }
.photo-icon-mountain::after { left: 18rpx; bottom: -12rpx; }

.photo-icon-plus {
  position: absolute;
  right: -12rpx;
  bottom: -10rpx;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #fbf7f1;
  border-radius: 50%;
  background: #a56f70;
  color: #fffaf6;
  font: 25rpx/32rpx sans-serif;
  text-align: center;
}

.upload-icon {
  position: relative;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #cdc0b1;
  border-radius: 24rpx;
  background: #fffdf9;
}

.upload-icon-body {
  width: 40rpx;
  height: 30rpx;
  border: 2rpx solid #a3948a;
  border-radius: 6rpx;
}

.upload-icon-dot {
  position: absolute;
  width: 4rpx;
  height: 22rpx;
  background: #a3948a;
}
.upload-icon-dot::after {
  position: absolute;
  top: -9rpx;
  left: -9rpx;
  width: 22rpx;
  height: 4rpx;
  background: #a3948a;
  content: "";
}

.upload-text {
  color: #6b5f55;
  font: 26rpx "Songti SC", serif;
  letter-spacing: 1rpx;
}

.change-chip {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 249, 0.94);
  color: #6b5f55;
  font-size: 21rpx;
  box-shadow: 0 4rpx 12rpx rgba(60, 44, 36, 0.12);
}

/* 拾光成花 / 识花成单：主按钮（位于上传卡与示例之间） */
.main-action {
  flex: 0 0 88rpx;
  margin-top: 22rpx;
  font-size: 30rpx;
}

.progress-action { padding: 10rpx 24rpx; }
.progress-action.is-generating { flex-basis: 142rpx; min-height: 142rpx; padding: 16rpx 24rpx; border: 2rpx solid rgba(255, 253, 249, .5); border-radius: 24rpx; box-shadow: 0 12rpx 30rpx rgba(125, 68, 69, .28); }
.bottom-action.progress-action.is-generating { flex-basis: 142rpx; }
.progress-action-content { display: flex; width: 100%; min-width: 0; flex-direction: column; gap: 10rpx; }
.progress-action-head { display: flex; width: 100%; align-items: center; justify-content: center; gap: 12rpx; }
.progress-action.is-generating .progress-action-head { justify-content: space-between; }
.progress-action-title { min-width: 0; font-size: 29rpx; font-weight: 600; line-height: 1.25; }
.progress-action-value { flex: 0 0 auto; color: #fffdf9; font-size: 24rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.progress-action-live { display: flex; flex: 0 0 auto; align-items: center; gap: 8rpx; color: #fffdf9; font-size: 21rpx; }
.progress-action-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #fffdf9; box-shadow: 0 0 0 5rpx rgba(255, 253, 249, .18); animation: progress-dot-pulse 1.25s ease-in-out infinite; }
.progress-action-track { position: relative; width: 100%; height: 11rpx; overflow: hidden; border-radius: 999rpx; background: rgba(255, 253, 249, 0.34); }
.progress-action-fill { height: 100%; border-radius: inherit; background: #fffdf9; transition: width 220ms ease-out; }
.progress-action-fill.is-indeterminate { position: absolute; left: 0; width: 32%; animation: progress-action-sweep 1.35s ease-in-out infinite; }
.progress-action-note { display: block; overflow: hidden; color: rgba(255, 253, 249, 0.96); font-size: 20rpx; line-height: 1.35; text-align: center; text-overflow: ellipsis; white-space: nowrap; }

@keyframes progress-action-sweep {
  0% { transform: translateX(-105%); }
  100% { transform: translateX(330%); }
}

@keyframes progress-dot-pulse {
  0%, 100% { opacity: .55; transform: scale(.86); }
  50% { opacity: 1; transform: scale(1.12); }
}

/* ---------------- 灵感示例行（三行对话式示例） ---------------- */
.ex-list {
  display: flex;
  flex: 1 1 auto;
  width: 100%;
  min-width: 0;
  min-height: 0;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  overflow-y: auto;
}

.ex-row {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  flex: 0 0 174rpx;
  align-self: stretch;
  min-height: 174rpx;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx;
  border: 1rpx solid #ece2d6;
  border-radius: 20rpx;
  background: #fffdf9;
  text-align: left;
  box-shadow: 0 6rpx 16rpx rgba(88, 64, 52, 0.05);
}

.ex-img {
  width: 150rpx;
  height: 150rpx;
  flex: 0 0 150rpx;
  border-radius: 14rpx;
  background: #f1e9e0;
}

.ex-img.wide {
  width: 220rpx;
  height: 150rpx;
  flex-basis: 220rpx;
}

.ex-img.result { background: #f6efe7; }

.ex-link {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  color: #c9a29b;
  font-size: 28rpx;
}

.ex-tx {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.ex-title {
  overflow: hidden;
  color: #4c4239;
  font: 25rpx "Songti SC", serif;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ex-desc {
  display: -webkit-box;
  overflow: hidden;
  color: #b3a497;
  font-size: 19rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* ---------------- 生成结果 / 场景结果 ---------------- */
.hero-image {
  width: 100%;
  height: calc(100vw - 32px);
  flex: 0 0 auto;
  border-radius: 26rpx;
  background: #f1e9e0;
  box-shadow: 0 12rpx 30rpx rgba(88, 64, 52, 0.1);
}

.hero-image.tall,
.hero-image.square-output { height: calc(100vw - 32px); }

.title-panel {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 28rpx;
  padding: 20rpx 24rpx 24rpx;
  border: 1rpx solid #ece2d6;
  border-radius: 20rpx;
  background: #fffdf9;
}

.panel-label {
  color: #9a8b7e;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.title-input {
  height: 64rpx;
  color: #3b342e;
  font: 30rpx "Songti SC", serif;
}

.title-placeholder { color: #c4b6a9; }

.source-block {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  margin-top: 26rpx;
}

.source-image {
  width: 100%;
  height: 260rpx;
  border-radius: 20rpx;
  background: #f1e9e0;
}

.scene-caption {
