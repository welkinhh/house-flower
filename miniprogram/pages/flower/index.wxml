<view class="app-shell mode-{{mode}}">

  <!-- 顶部导航：返回 + 居中标题 -->
  <view wx:if="{{mode !== 'home' && mode !== 'portfolio' && mode !== 'generationResult'}}" class="topbar">
    <button class="back-button" bindtap="goBack" aria-label="返回">
      <view class="icon-back"></view>
    </button>
    <text class="page-title">{{topCaption}}</text>
  </view>

  <!-- ============ 1. 首页（整屏铺满，卡片压在底部） ============ -->
  <view wx:if="{{mode === 'home'}}" class="home-screen">
    <image wx:if="{{editorialAssetsReady}}" class="home-bg" src="{{homeHero}}" mode="aspectFill" />
    <view class="home-veil"></view>
    <view wx:if="{{!editorialAssetsReady}}" class="home-image-status">{{editorialAssetsLoading ? '正在加载高清图片…' : '高清图片暂不可用，请检查网络后重试'}}</view>
    <view class="hero-head">
      <button class="hero-settings" bindtap="openSettings" aria-label="设置">⚙</button>
      <text class="hero-brand">{{brand.shopName}}</text>
      <view class="hero-slogan">
        <text>{{brand.slogan}}</text>
      </view>
    </view>

    <view class="home-entries" wx:if="{{homeEntries.length}}">
      <button wx:for="{{homeEntries}}" wx:key="id" class="hcard" data-id="{{item.id}}" bindtap="openEntry">
        <view class="hcard-frame"><image wx:if="{{editorialAssetsReady && item.path}}" src="{{item.path}}" mode="aspectFill" lazy-load="true" /></view>
        <view class="hcard-copy">
          <text class="hcard-title">{{item.title}}</text>
          <text class="hcard-note">{{item.note}}</text>
        </view>
        <view class="hcard-arrow">→</view>
      </button>
    </view>

    <!-- 充值入口：任何人都能创作，次数用完就地充值 -->
    <view class="home-quota-entry" bindtap="openRecharge">
      <view class="hq-copy">
        <text class="hq-title">剩余 {{remainingUses}} 次 · {{welcomeQuota.tier === 'shop' ? '花店账号免费 30 次' : '个人账号免费 5 次'}}</text>
        <text class="hq-sub">次数不会每日清零，用完可充值</text>
      </view>
      <view class="hq-arrow">→</view>
    </view>
  </view>

  <!-- ============ 2. 拾光成花 ============ -->
  <view wx:if="{{mode === 'inspiration'}}" class="screen">
    <view class="copy-block slim">
      <text class="screen-desc strong">选一张照片，变成一束花</text>
    </view>

    <button class="upload-card {{inspirationPath ? 'has-image' : ''}}" bindtap="chooseInspiration" disabled="{{generating || generationResumePending}}">
      <image wx:if="{{inspirationPath}}" src="{{inspirationPath}}" mode="aspectFit" class="upload-photo" />
      <view wx:else class="upload-empty">
        <view class="photo-upload-icon">
          <view class="photo-icon-sun"></view>
          <view class="photo-icon-mountain"></view>
          <view class="photo-icon-plus">＋</view>
        </view>
        <text class="upload-text">上传相册图片</text>
      </view>
      <view wx:if="{{inspirationPath}}" class="change-chip" catchtap="chooseInspiration">更换图片</view>
    </button>

    <view class="section-head">
      <text class="section-title">灵感示例</text>
    </view>
    <view class="ex-list">
      <button wx:for="{{inspirationExamples}}" wx:key="id" class="ex-row" data-path="{{item.path}}" data-label="{{item.title}}" data-asset-key="{{item.assetKey}}" bindtap="chooseInspirationSample" disabled="{{!editorialAssetsReady}}">
        <image wx:if="{{editorialAssetsReady && item.path}}" class="ex-img" src="{{item.path}}" mode="aspectFill" lazy-load="true" />
        <view class="ex-link"><text>→</text></view>
        <image wx:if="{{editorialAssetsReady && item.resultPath}}" class="ex-img result" src="{{item.resultPath}}" mode="aspectFill" lazy-load="true" />
        <view class="ex-tx">
          <text class="ex-title">{{item.title}}</text>
          <text class="ex-desc">{{item.description}}</text>
        </view>
      </button>
    </view>
    <text wx:if="{{inspirationMessage}}" class="status-message">{{inspirationMessage}}</text>
    <button class="btn primary main-action progress-action {{generating || generationResumePending ? 'is-generating' : ''}}" bindtap="applyInspiration" disabled="{{!inspirationPath || generating}}">
      <view class="progress-action-content">
        <view class="progress-action-head">
          <text class="progress-action-title">{{generating ? generationProgressLabel : generationResumePending ? '继续查看生成进度' : '变成一束花'}}</text>
          <text wx:if="{{(generating || generationResumePending) && generationProgressMode === 'determinate'}}" class="progress-action-value">{{generationProgressPercent}}%</text>
          <view wx:elif="{{generating || generationResumePending}}" class="progress-action-live"><view class="progress-action-dot"></view><text>后台处理中</text></view>
          <view wx:else class="icon-arrow">→</view>
        </view>
        <view wx:if="{{generating || generationResumePending}}" class="progress-action-track">
          <view class="progress-action-fill {{generationProgressMode === 'indeterminate' ? 'is-indeterminate' : ''}}" style="{{generationProgressFillStyle}}"></view>
        </view>
        <text wx:if="{{generating || generationResumePending}}" class="progress-action-note">{{generationProgressNote}}</text>
      </view>
    </button>
  </view>

  <!-- ============ 3. 生成结果 ============ -->
  <view wx:if="{{mode === 'generationResult'}}" class="screen generated-screen">
    <image class="generated-full-image" src="{{generationPreviewPath}}" mode="aspectFit" bindtap="previewImage" data-path="{{generationPreviewPath}}" />
    <view class="generated-top-actions">
      <button class="result-icon-button" bindtap="goBack" aria-label="返回"><view class="icon-back"></view></button>
      <button class="result-icon-button download-result-button" bindtap="downloadGeneratedImage" aria-label="下载图片"><view class="download-glyph">↓</view></button>
    </view>
    <view wx:if="{{generationDemo}}" class="generated-demo-tag">示例效果</view>
    <view class="generated-info-card">
      <image wx:if="{{generationSourcePath}}" class="generated-source-thumb" src="{{generationSourcePath}}" mode="aspectFit" bindtap="previewImage" data-path="{{generationSourcePath}}" />
      <view class="generated-info-copy">
        <input class="generated-name-input" maxlength="24" value="{{bouquetTitle}}" bindinput="updateBouquetTitle" placeholder="给这束花取个名字" />
        <text class="generated-date">{{generationDateLabel}}</text>
      </view>
    </view>
    <view class="generated-action-row">
      <button class="btn outline" bindtap="recognizeGeneratedBouquet" disabled="{{generationDemo}}">识别花材清单</button>
      <button class="btn primary" bindtap="saveGeneratedWork"><view class="save-icon"></view>保存到作品集</button>
    </view>
  </view>

  <!-- ============ 4. 识花成单 ============ -->
  <view wx:if="{{mode === 'recognition'}}" class="screen">
    <view class="copy-block slim">
      <text class="screen-desc strong">看看这束花用了什么花材</text>
    </view>

    <button class="upload-card {{replicaPath ? 'has-image' : ''}}" bindtap="chooseReplica" disabled="{{identifying}}">
      <image wx:if="{{replicaPath}}" src="{{replicaPath}}" mode="aspectFit" class="upload-photo" />
      <view wx:else class="upload-empty">
        <view class="photo-upload-icon">
          <view class="photo-icon-sun"></view>
          <view class="photo-icon-mountain"></view>
          <view class="photo-icon-plus">＋</view>
        </view>
        <text class="upload-text">上传相册图片</text>
      </view>
      <view wx:if="{{replicaPath}}" class="change-chip" catchtap="chooseReplica">更换图片</view>
    </button>

    <view class="section-head">
      <text class="section-title">灵感示例</text>
    </view>
    <view class="ex-list">
      <button wx:for="{{recognitionExamples}}" wx:key="id" class="ex-row" data-id="{{item.id}}" data-path="{{item.path}}" data-asset-key="{{item.assetKey}}" bindtap="chooseReplicaSample" disabled="{{!editorialAssetsReady}}">
        <image wx:if="{{editorialAssetsReady && item.path}}" class="ex-img wide" src="{{item.path}}" mode="aspectFill" lazy-load="true" />
        <view class="ex-tx">
          <text class="ex-title">{{item.label}}</text>
          <text class="ex-desc">{{item.description}}</text>
        </view>
      </button>
    </view>
    <text wx:if="{{!visionAvailable}}" class="recognition-unavailable-note">识花模型暂未开通；选择示例可预览清单。</text>
    <text wx:if="{{replicaMessage}}" class="status-message">{{replicaMessage}}</text>
    <button class="btn primary main-action" bindtap="replicaAction" disabled="{{!replicaPath || identifying || (!visionAvailable && !replicaSampleId)}}">
      {{identifying ? recognitionStageLabel : replicaSampleId ? '查看示例清单' : visionAvailable ? '生成清单' : '识花模型暂未开通'}}
      <view wx:if="{{!identifying && (visionAvailable || replicaSampleId)}}" class="icon-arrow">→</view>
    </button>
  </view>

  <!-- ============ 5. 调整清单（识花结果） ============ -->
  <view wx:if="{{mode === 'recognitionResult'}}" class="screen">
    <view class="adjust-top">
      <image class="adjust-photo" src="{{replicaPath}}" mode="aspectFit" bindtap="previewImage" data-path="{{replicaPath}}" />
      <view class="adjust-copy">
        <text class="adjust-name">原照片</text>
        <text class="adjust-note">轻触查看；遮挡部分可能无法识别</text>
      </view>
      <button class="chip-button" bindtap="replicaAgain">重新识别</button>
    </view>

    <view class="section-head">
      <text class="section-title">花材清单（{{replicaCandidates.length}} 种）</text>
      <button class="link-button" bindtap="addCandidate">＋ 添加漏识花材</button>
    </view>
    <view wx:if="{{replicaDemo}}" class="demo-list-note">示例清单 · 仅供版式预览</view>

    <view class="material-head">
      <text>花图</text><text>名称</text><text>颜色</text><text>数量</text>
    </view>
    <scroll-view scroll-y enhanced show-scrollbar="false" class="material-list">
      <view wx:for="{{replicaCandidates}}" wx:key="id" class="material-row">
        <view class="material-thumb">
          <image wx:if="{{item.assetPath}}" src="{{item.assetPath}}" mode="aspectFit" />
          <view wx:else class="list-color-mark" style="background: {{item.swatch}}"></view>
        </view>
        <text class="material-name" data-index="{{index}}" data-field="name" bindtap="editCandidateText">{{item.name}}</text>
        <text class="material-sub" data-index="{{index}}" data-field="colorLabel" bindtap="editCandidateText">{{item.colorLabel}}</text>
        <view class="material-controls">
          <view class="stepper">
            <button class="step-btn" data-index="{{index}}" data-delta="-1" bindtap="stepCandidateQuantity">−</button>
            <text class="step-num" data-index="{{index}}" bindtap="editCandidateQuantity">{{item.confirmed ? item.quantity + item.unit : item.quantityLabel}}</text>
            <button class="step-btn" data-index="{{index}}" data-delta="1" bindtap="stepCandidateQuantity">＋</button>
          </view>
          <button class="row-delete" data-index="{{index}}" bindtap="removeCandidate">×</button>
        </view>
      </view>
      <view wx:if="{{!replicaCandidates.length}}" class="material-empty">还没有识别结果</view>
    </scroll-view>
    <text class="estimate-note">数量仅供参考，请按实物确认；点名称可修改花材信息。</text>

    <view class="action-row material-actions {{replicaDemo ? 'demo-only' : ''}}">
      <button wx:if="{{!replicaDemo}}" class="btn outline" bindtap="saveReplicaWork"><view class="save-icon"></view>保存到作品集</button>
      <button class="btn primary" bindtap="downloadMaterials">导出清单</button>
    </view>
  </view>

  <!-- ============ 6. 花映生活（场景融合编辑） ============ -->
  <view wx:if="{{mode === 'scene'}}" class="screen">
    <view class="scene-chips">
      <button class="scene-chip" bindtap="chooseBouquet" disabled="{{sceneGenerating}}">
        <image wx:if="{{sceneBouquetPath}}" src="{{sceneBouquetPath}}" mode="aspectFit" class="chip-thumb" />
        <view wx:else class="chip-thumb chip-empty">＋</view>
        <view class="chip-copy">
          <text class="chip-label">{{sceneBouquetPath ? '更换花束' : '上传花束'}}</text>
          <text class="chip-value">{{sceneBouquetPath ? '轻触更换' : '从手机相册选择图片'}}</text>
        </view>
      </button>
      <button class="scene-chip" bindtap="chooseScene" disabled="{{sceneGenerating}}">
        <image wx:if="{{editorialAssetsReady && scenePath}}" src="{{scenePath}}" mode="aspectFit" class="chip-thumb" lazy-load="true" />
        <view wx:else class="chip-thumb chip-empty">＋</view>
        <view class="chip-copy">
          <text class="chip-label">{{scenePath ? '更换场景图' : '上传场景图'}}</text>
          <text class="chip-value">{{scenePath ? sceneTitle : '从相册选择场景'}}</text>
        </view>
      </button>
    </view>
    <view class="scene-board" id="scene-board">
      <image wx:if="{{editorialAssetsReady && scenePath}}" class="scene-background" src="{{scenePath}}" mode="aspectFit" lazy-load="true" />
      <view wx:else class="scene-empty"><text>先选择一个生活场景</text></view>
      <image wx:if="{{sceneBouquetPath}}" class="scene-bouquet-overlay" src="{{sceneBouquetPath}}" mode="aspectFit" style="{{sceneBouquetStyle}}" bindtouchstart="onSceneBouquetTouchStart" bindtouchmove="onSceneBouquetTouchMove" bindtouchend="onSceneBouquetTouchEnd" bindtouchcancel="onSceneBouquetTouchEnd" />
      <text wx:if="{{sceneBouquetPath}}" class="drag-hint">拖动调整位置</text>
    </view>

    <view wx:if="{{sceneBouquetPath}}" class="scene-scale-control">
      <view class="scene-scale-head"><text>花束大小</text><text class="scene-scale-value">{{sceneScaleLabel}}</text><text class="scene-scale-hint">双指也可缩放</text></view>
      <slider class="scene-scale-slider" min="32" max="145" step="1" value="{{sceneScalePercent}}" activeColor="#a56f70" backgroundColor="#e6ddd3" block-color="#a56f70" block-size="18" disabled="{{sceneGenerating}}" bindchanging="changeSceneScale" bindchange="changeSceneScale" />
    </view>

    <view class="section-head">
      <text class="section-title">选择空间模板</text>
    </view>
    <scroll-view scroll-x enhanced show-scrollbar="false" class="scene-strip">
      <view class="scene-list">
        <button wx:for="{{sceneOptions}}" wx:key="id" class="scene-option {{selectedSceneId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseScenePreset" disabled="{{sceneGenerating || !editorialAssetsReady}}">
          <image wx:if="{{editorialAssetsReady && item.path}}" src="{{item.path}}" mode="aspectFill" lazy-load="true" />
          <text>{{item.name}}</text>
          <view wx:if="{{selectedSceneId === item.id}}" class="scene-check">✓</view>
        </button>
      </view>
    </scroll-view>

    <text wx:if="{{sceneMessage}}" class="status-message">{{sceneMessage}}</text>
    <button class="btn primary bottom-action progress-action {{sceneGenerating ? 'is-generating' : ''}}" bindtap="composeScene" disabled="{{!scenePath || !sceneBouquetPath || sceneGenerating}}">
      <view class="progress-action-content">
        <view class="progress-action-head">
          <text class="progress-action-title">{{sceneGenerating ? generationProgressLabel : '生成场景效果'}}</text>
          <text wx:if="{{sceneGenerating && generationProgressMode === 'determinate'}}" class="progress-action-value">{{generationProgressPercent}}%</text>
          <text wx:elif="{{sceneGenerating}}" class="progress-action-live">创作中</text>
          <view wx:else class="icon-arrow">→</view>
        </view>
        <view wx:if="{{sceneGenerating}}" class="progress-action-track">
          <view class="progress-action-fill {{generationProgressMode === 'indeterminate' ? 'is-indeterminate' : ''}}" style="{{generationProgressFillStyle}}"></view>
        </view>
        <text wx:if="{{sceneGenerating}}" class="progress-action-note">{{generationProgressNote}}</text>
      </view>
    </button>
  </view>

  <!-- ============ 7. 场景融合结果 ============ -->
  <scroll-view wx:if="{{mode === 'sceneResult'}}" class="screen scroll-area" scroll-y enhanced show-scrollbar="false">
    <image class="hero-image tall" src="{{sceneResultPath}}" mode="aspectFit" bindtap="previewImage" data-path="{{sceneResultPath}}" />
    <view class="scene-caption">
      <text class="scene-name">{{sceneTitle}} · 花映生活</text>
      <text class="scene-sub">花束已融入所选空间，轻触图片可放大查看</text>
    </view>
    <view class="action-row">
      <button class="btn outline" bindtap="returnToScene">重新调整</button>
      <button class="btn primary" bindtap="downloadSceneImage">下载效果图</button>
    </view>
    <button class="link-save" bindtap="saveScene">保存到作品集</button>
  </scroll-view>

  <!-- ============ 9. 作品集（统一门面） ============ -->
  <view wx:if="{{mode === 'portfolio'}}" class="screen works-screen">
    <view class="works-header">
      <view class="header-copy">
        <text class="header-name">{{brand.shopName}}</text>
        <text class="header-id">{{portfolioItems.length}} 件作品</text>
      </view>
      <button wx:if="{{selectingWorks}}" class="header-action" bindtap="toggleWorkSelectionMode">取消</button>
      <view wx:else class="header-uses">
        <text class="uses-label">剩余次数</text>
        <text class="uses-num">{{remainingUses}}</text>
      </view>
    </view>

    <!-- 额度条：免费额度用完后引导充值，任何人都可见 -->
    <view class="quota-bar">
      <view class="quota-bar-copy">
        <text class="quota-bar-title">{{welcomeQuota.tier === 'shop' ? '花店账号' : '个人账号'}} · 免费 {{welcomeQuota.total}} 次</text>
        <text class="quota-bar-note">{{remainingUses > 0 ? '免费次数用完后再充值，次数不会每日清零' : '免费次数已用完，充值后可继续创作'}}</text>
      </view>
      <button class="quota-bar-btn" bindtap="openRecharge">充值</button>
    </view>

    <!-- 店主操作条：作品管理类操作仅店主可见；AI 创作对所有人开放 -->
    <view wx:if="{{isAdmin}}" class="pf-toolbar">
      <button class="pf-tool" bindtap="startUploadWork"><text class="pf-tool-ico">＋</text><text>上传实拍</text></button>
      <button class="pf-tool" bindtap="toggleWorkSelectionMode"><text class="pf-tool-ico">☰</text><text>管理</text></button>
    </view>
    <view wx:else class="pf-toolbar">
      <button class="pf-tool" bindtap="openCreationSheet"><text class="pf-tool-ico">✿</text><text>AI 创作</text></button>
    </view>

    <view class="pf-search-row">
      <input class="pf-search" value="{{portfolioSearch}}" bindinput="searchPortfolio" placeholder="搜索作品名称或备注" placeholder-class="pf-search-ph" />
      <button wx:if="{{portfolioSearch}}" class="pf-search-clear" bindtap="clearPortfolioSearch" aria-label="清空">×</button>
    </view>

    <scroll-view scroll-x enhanced show-scrollbar="false" class="pf-tabs">
      <view class="pf-tabs-inner">
        <button wx:for="{{portfolioCategories}}" wx:key="id" class="pf-tab {{portfolioCategory === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectPortfolioCategory">{{item.label}}</button>
      </view>
    </scroll-view>

    <!-- 作品集 -->
    <view wx:if="{{worksView === 'collection'}}" class="collection-view">
      <scroll-view scroll-y enhanced show-scrollbar="false" class="works-scroll" bindscrolltolower="loadMoreWorks">
        <view wx:if="{{recentTasks.length}}" class="recovery-list">
          <view class="recovery-heading-row"><text class="recovery-heading">创作进度</text><text wx:if="{{recentTasks.length > 2}}" class="recovery-scroll-hint">滑动查看更多</text></view>
          <scroll-view scroll-y enhanced show-scrollbar="false" class="recovery-scroll {{recentTasks.length > 2 ? 'scroll-limited' : ''}}">
            <view wx:for="{{recentTasks}}" wx:key="taskId" class="recovery-row">
              <view class="recovery-indicator {{item.status === 'succeeded' ? 'complete' : ''}}"></view>
              <view class="recovery-copy"><text>{{item.title}} · {{item.statusLabel}}</text><text>{{item.status === 'succeeded' ? '请在 24 小时内保存到作品集' : item.status === 'reconciling' ? '系统正在核对结果与使用次数' : '任务会在后台继续处理'}}</text></view>
              <button class="recovery-open" data-id="{{item.taskId}}" bindtap="openRecentTask" disabled="{{resumingTaskId === item.taskId}}">{{resumingTaskId === item.taskId ? '连接中' : item.status === 'succeeded' ? '查看' : '恢复'}}</button>
            </view>
          </scroll-view>
        </view>
        <view wx:if="{{portfolioItems.length}}" class="works-grid">
          <view wx:for="{{portfolioItems}}" wx:key="id" class="work-card {{item.selected ? 'selected' : ''}}">
            <view class="work-image-wrap" data-index="{{index}}" bindtap="openWork" bindlongpress="workLongPress">
              <image wx:if="{{item.previewPath}}" src="{{item.previewPath}}" mode="aspectFill" class="work-image" lazy-load="true" />
              <view wx:else class="work-image-empty"><text>{{brand.shopName}}</text></view>
              <view class="work-veil"></view>
              <view class="work-cat-chip">{{item.categoryLabel}}</view>
              <view class="work-tx">
                <text class="work-title">{{item.title}}</text>
                <text class="work-date">{{item.dateLabel}}</text>
              </view>
              <view wx:if="{{selectingWorks}}" class="work-select-mark {{item.selected ? 'on' : ''}}">✓</view>
            </view>
          </view>
        </view>
        <view wx:else class="works-empty">
          <text class="empty-title">{{isAdmin ? '上架第一件作品' : '还没有作品'}}</text>
          <text class="empty-sub">{{isAdmin ? '上传实拍照片，或用 AI 创作生成花束图。' : '用首页的 AI 创作生成第一束花，保存后就会出现在这里。'}}</text>
        </view>
        <view wx:if="{{cloudWorksLoading || cloudWorksHasMore}}" class="works-load-note">{{cloudWorksLoading ? '正在加载作品…' : '继续上滑加载更多'}}</view>
      </scroll-view>

      <view wx:if="{{selectingWorks}}" class="select-bar">
        <text class="select-count">已选 {{selectedWorkIds.length}} 件</text>
        <view class="select-actions">
          <button class="link-button" bindtap="toggleSelectAllWorks">{{selectedWorkIds.length === portfolioItems.length ? '取消全选' : '全选'}}</button>
          <button class="delete-button" bindtap="deleteSelectedWorks" disabled="{{!selectedWorkIds.length}}">删除</button>
        </view>
      </view>
    </view>

  </view>

  <!-- ============ 10. 设置 ============ -->
  <view wx:if="{{mode === 'settings'}}" class="screen settings-screen">
    <view class="settings-card">
      <button class="settings-avatar" bindtap="chooseAvatar">
        <image wx:if="{{editorialAssetsReady || userProfile.avatarAssetId}}" src="{{userProfile.avatarUrl}}" mode="aspectFill" />
        <view class="avatar-edit">更换</view>
      </button>
      <text class="settings-hint">点头像可更换头像</text>

      <label class="editor-field">
        <text>名称</text>
        <input value="{{userProfile.name}}" bindinput="updateProfileName" maxlength="24" placeholder-class="title-placeholder" />
      </label>
      <view class="settings-id">
        <text>ID</text>
        <text>{{userProfile.id}}</text>
      </view>

      <button class="settings-row feedback-button" open-type="feedback">
        <text>意见反馈</text>
        <text class="chev">›</text>
      </button>

      <view class="privacy-guide">
        <view class="privacy-guide-heading">
          <text class="privacy-guide-title">隐私保护说明</text>
          <button class="privacy-guide-link" bindtap="openPrivacyGuide" hover-class="none">查看完整指引 ›</button>
        </view>
        <text class="privacy-guide-copy">你主动选择用于花束生成或场景合成的照片会上传至腾讯云，并由腾讯混元图生图服务处理。昵称、头像、保存的作品会同步到云端。</text>
        <text class="privacy-guide-copy">未保存任务的临时图片会在完成 24 小时后清理；仅在你点击“保存图片”时写入相册。你可以在本页申请删除账号及相关云端数据。</text>
      </view>

      <button class="btn primary settings-save" bindtap="saveProfile">保存</button>
      <button class="btn outline settings-sync" bindtap="syncLocalWorks">同步本机作品</button>
      <button wx:if="{{isAdmin}}" class="btn outline settings-sync" bindtap="openAdminPanel">运营数据</button>
      <button class="settings-danger" bindtap="deleteAccount">删除账号</button>
    </view>
  </view>

  <!-- ============ 12. 充值次数 ============ -->
  <view wx:if="{{mode === 'recharge'}}" class="screen recharge-screen">
    <scroll-view scroll-y enhanced show-scrollbar="false" class="recharge-scroll">
      <view class="recharge-balance">
        <text class="recharge-balance-label">剩余可创作次数</text>
        <text class="recharge-balance-num">{{remainingUses}}</text>
        <text class="recharge-balance-note">{{welcomeQuota.tier === 'shop' ? '花店账号免费 30 次' : '个人账号免费 5 次'}}，用完后可按需充值，次数不会每日清零。</text>
      </view>

      <view class="section-head">
        <text class="section-title">选择充值包</text>
        <text wx:if="{{!paymentConfig.enabled}}" class="section-note">收款待开通</text>
      </view>
      <view class="recharge-plans">
        <button wx:for="{{rechargePlans}}" wx:key="id" class="rplan {{item.badge ? 'on' : ''}}" data-id="{{item.id}}" bindtap="chooseRechargePlan" disabled="{{rechargeBusy}}">
          <text wx:if="{{item.badge}}" class="rplan-badge">{{item.badge}}</text>
          <text class="rplan-uses">{{item.uses}} 次</text>
          <text class="rplan-price">¥{{item.amountYuan}}</text>
          <text class="rplan-unit">约 ¥{{item.unitPrice}}/次</text>
        </button>
      </view>

      <view wx:if="{{!paymentConfig.enabled}}" class="recharge-notice">
        <text class="recharge-notice-title">充值收款尚未开通</text>
        <text class="recharge-notice-copy">{{paymentConfig.notice}}</text>
      </view>

      <view wx:if="{{rechargeOrders.length}}" class="recharge-orders">
        <view class="section-head"><text class="section-title">充值记录</text></view>
        <view wx:for="{{rechargeOrders}}" wx:key="orderId" class="rorder">
          <view class="rorder-copy">
            <text class="rorder-title">{{item.planLabel}}</text>
            <text class="rorder-meta">¥{{item.amountYuan}} · {{item.statusLabel}}</text>
          </view>
          <text class="rorder-status {{item.status === 'credited' ? 'ok' : ''}}">{{item.statusLabel}}</text>
        </view>
      </view>

      <view class="privacy-guide">
        <view class="privacy-guide-heading">
          <text class="privacy-guide-title">关于充值</text>
        </view>
        <text class="privacy-guide-copy">充值次数为一次性额度，不会每日清零，也不会过期。生成失败或主动取消时，次数会自动退回。</text>
        <text class="privacy-guide-copy">iPhone 用户在小程序内购买虚拟次数可能受平台限制，部分机型无法完成支付；遇到支付失败请更换设备或联系店主协助处理。</text>
      </view>
    </scroll-view>
  </view>

  <!-- ============ 11. 运营数据 ============ -->
  <view wx:if="{{mode === 'admin'}}" class="screen admin-screen">
    <view class="admin-range-row">
      <text class="section-title">近 {{adminRange}} 天</text>
      <view class="admin-range-tabs">
        <button class="admin-range {{adminRange === 7 ? 'active' : ''}}" data-range="7" bindtap="selectAdminRange">7 天</button>
        <button class="admin-range {{adminRange === 30 ? 'active' : ''}}" data-range="30" bindtap="selectAdminRange">30 天</button>
        <button class="admin-range {{adminRange === 90 ? 'active' : ''}}" data-range="90" bindtap="selectAdminRange">90 天</button>
      </view>
    </view>
    <view class="admin-scroll">
      <view class="admin-gift-card">
        <view class="section-head"><text class="section-title">设为花店</text><text class="section-note">仅管理员可用</text></view>
        <text class="admin-gift-note">花店账号首次登录会获赠 30 次，个人账号 5 次，均为一次性、不过期。降级不会收回已赠送的次数。</text>
        <label class="admin-gift-field">
          <text>用户 ID</text>
          <input value="{{shopUserId}}" bindinput="updateShopUserId" maxlength="32" placeholder="输入完整用户 ID" disabled="{{shopBusy}}" />
        </label>
        <view class="admin-gift-row">
          <button class="btn primary admin-gift-submit" bindtap="upgradeShopAccount" loading="{{shopBusy}}" disabled="{{shopBusy}}">设为花店（+30 次）</button>
          <button class="btn outline admin-gift-submit" bindtap="downgradeShopAccount" disabled="{{shopBusy}}">改回个人</button>
        </view>
      </view>

      <view class="admin-gift-card">
        <view class="section-head"><text class="section-title">核销充值订单</text><text class="section-note">仅管理员可用</text></view>
        <text class="admin-gift-note">收款通道尚未开通时，用户无法在线支付。收到线下转账后，在这里输入订单 ID 核销并到账次数。</text>
        <label class="admin-gift-field">
          <text>订单 ID</text>
          <input value="{{rechargeOrderId}}" bindinput="updateRechargeOrderId" maxlength="80" placeholder="recharge_..." disabled="{{rechargeConfirmBusy}}" />
        </label>
        <label class="admin-gift-field">
          <text>支付流水号（可选）</text>
          <input value="{{rechargeTransactionId}}" bindinput="updateRechargeTransactionId" maxlength="80" placeholder="微信支付流水号" disabled="{{rechargeConfirmBusy}}" />
        </label>
        <button class="btn primary admin-gift-submit" bindtap="confirmRechargeOrder" loading="{{rechargeConfirmBusy}}" disabled="{{rechargeConfirmBusy}}">{{rechargeConfirmBusy ? '处理中…' : '确认到账'}}</button>
      </view>

      <view class="admin-gift-card">
        <view class="section-head"><text class="section-title">赠送 AI 次数</text><text class="section-note">仅管理员可用</text></view>
        <text class="admin-gift-note">赠送次数为一次性额度，不会每日重置，也不会过期。用户 ID 可从作品页点击头像查看。</text>
        <label class="admin-gift-field">
          <text>用户 ID</text>
          <input value="{{quotaGiftUserId}}" bindinput="updateQuotaGiftUserId" maxlength="32" placeholder="输入完整用户 ID" disabled="{{quotaGiftBusy}}" />
        </label>
        <view class="admin-gift-row">
          <label class="admin-gift-field admin-gift-count">
            <text>赠送次数</text>
            <input type="number" value="{{quotaGiftCount}}" bindinput="updateQuotaGiftCount" placeholder="1" disabled="{{quotaGiftBusy}}" />
          </label>
          <label class="admin-gift-field admin-gift-reason">
            <text>赠送原因（可选）</text>
            <input value="{{quotaGiftReason}}" bindinput="updateQuotaGiftReason" maxlength="120" placeholder="例如：活动奖励" disabled="{{quotaGiftBusy}}" />
          </label>
        </view>
        <button class="btn primary admin-gift-submit" bindtap="grantQuotaGift" loading="{{quotaGiftBusy}}" disabled="{{quotaGiftBusy}}">{{quotaGiftBusy ? '处理中…' : '确认赠送'}}</button>
      </view>
      <block wx:if="{{adminSummary}}">
      <view class="admin-grid">
        <view class="admin-card"><text>新增用户</text><text class="admin-number">{{adminSummary.overview.newUsers}}</text></view>
        <view class="admin-card"><text>活跃用户</text><text class="admin-number">{{adminSummary.overview.activeUsers}}</text></view>
        <view class="admin-card"><text>AI 任务</text><text class="admin-number">{{adminSummary.overview.aiTasks}}</text></view>
        <view class="admin-card"><text>成功任务</text><text class="admin-number">{{adminSummary.overview.aiSucceeded}}</text></view>
        <view class="admin-card"><text>保存花束</text><text class="admin-number">{{adminSummary.overview.savedWorks}}</text></view>
        <view class="admin-card"><text>保存清单</text><text class="admin-number">{{adminSummary.overview.savedLists}}</text></view>
        <view class="admin-card"><text>订阅授权</text><text class="admin-number">{{adminSummary.overview.subscriptionAccepts}}</text></view>
        <view class="admin-card"><text>提醒发送</text><text class="admin-number">{{adminSummary.overview.notificationsSent}}</text></view>
      </view>
      <view class="admin-section">
        <view class="section-head"><text class="section-title">AI 使用情况</text><text class="section-note">成功 / 失败</text></view>
        <view wx:for="{{adminSummary.taskByType}}" wx:key="type" class="admin-line"><text>{{item.type}}</text><text>{{item.total}}</text><text class="admin-muted">{{item.succeeded}} / {{item.failed}}</text></view>
      </view>
      <view class="admin-section">
        <view class="section-head"><text class="section-title">灵感偏好</text><text class="section-note">点击与使用次数</text></view>
        <view wx:for="{{adminSummary.preferences}}" wx:key="key" class="admin-line"><text>{{item.key}}</text><text class="admin-number-small">{{item.count}}</text></view>
        <text wx:if="{{!adminSummary.preferences.length}}" class="admin-muted">暂无足够数据</text>
      </view>
      <text wx:if="{{adminSummary.truncated}}" class="admin-muted">数据量较大，当前显示最近一部分记录。</text>
      </block>
      <view wx:else class="admin-loading">正在读取运营数据…</view>
    </view>
  </view>

  <!-- ============ 11. 作品详情 ============ -->
  <view wx:if="{{mode === 'workDetail' && currentWork}}" class="screen work-detail-screen">
    <scroll-view scroll-y enhanced show-scrollbar="false" class="detail-scroll">
      <image wx:if="{{currentWork.previewPath}}" class="hero-image square-output" src="{{currentWork.previewPath}}" mode="aspectFit" bindtap="openWorkImageViewer" />
      <view class="detail-heading">
        <text class="detail-title">{{currentWork.title}}</text>
        <text class="detail-sub">{{currentWork.categoryLabel}} · {{currentWork.kindLabel}} · {{currentWork.dateLabel}}</text>
        <button class="detail-more" bindtap="workMore" aria-label="更多作品操作">···</button>
      </view>
      <view wx:if="{{currentWork.showSource}}" class="source-block">
        <view class="section-head">
          <text class="section-title">灵感来源</text>
          <text class="section-note">轻触查看原图</text>
        </view>
        <image class="source-image" src="{{currentWork.sourcePath}}" mode="aspectFit" bindtap="previewImage" data-path="{{currentWork.sourcePath}}" />
      </view>
      <view class="work-note-block">
        <view class="section-head"><text class="section-title">作品备注</text><text class="section-note">{{currentWork.noteLength || 0}}/100</text></view>
        <textarea class="work-note-input" value="{{currentWork.note}}" maxlength="100" placeholder="写下这束花的灵感，最多100字" bindinput="updateWorkNote" bindblur="saveWorkNote" />
      </view>
      <view wx:if="{{currentWork.rows.length}}" class="saved-materials">
        <view class="section-head">
          <text class="section-title">花材清单</text>
          <text class="section-note">点数量可微调</text>
        </view>
        <view class="material-head"><text>花图</text><text>名称</text><text>颜色</text><text>数量</text></view>
        <view wx:for="{{currentWork.rows}}" wx:key="id" class="material-row">
          <view class="material-thumb">
            <image wx:if="{{item.assetPath}}" src="{{item.assetPath}}" mode="aspectFit" />
            <view wx:else class="list-color-mark" style="background: {{item.swatch}}"></view>
          </view>
          <text class="material-name" data-index="{{index}}" data-field="name" data-saved="true" bindtap="editCandidateText">{{item.name}}</text>
          <text class="material-sub" data-index="{{index}}" data-field="colorLabel" data-saved="true" bindtap="editCandidateText">{{item.colorLabel}}</text>
          <button class="quantity-chip" data-index="{{index}}" bindtap="editSavedQuantity">
            {{item.confirmed ? item.quantity + item.unit : item.quantityLabel}}
          </button>
        </view>
        <text class="estimate-note">照片估算结果；点击数量可微调。</text>
      </view>
    </scroll-view>
    <view wx:if="{{brand.contactWechat || brand.contactPhone}}" class="contact-block">
      <view class="section-head">
        <text class="section-title">联系老板</text>
        <text class="section-note">成交走淘宝 / 闲鱼，不经平台支付</text>
      </view>
      <view class="contact-actions">
        <button wx:if="{{brand.contactWechat}}" class="contact-btn" bindtap="copyWechat">
          <view class="contact-glyph">微</view>
          <view class="contact-copy"><text class="contact-label">微信</text><text class="contact-value">{{brand.contactWechat}}</text></view>
          <text class="contact-cta">复制</text>
        </button>
        <button wx:if="{{brand.contactPhone}}" class="contact-btn" bindtap="callPhone">
          <view class="contact-glyph">电</view>
          <view class="contact-copy"><text class="contact-label">电话</text><text class="contact-value">{{brand.contactPhone}}</text></view>
          <text class="contact-cta">拨打</text>
        </button>
      </view>
    </view>
    <view class="action-row">
      <button wx:if="{{currentWork.rows.length}}" class="btn outline" bindtap="downloadSavedMaterials"><view class="list-icon"></view>导出清单</button>
      <button wx:if="{{!currentWork.rows.length}}" class="btn outline" bindtap="recognizeSavedWork"><view class="list-icon"></view>生成清单</button>
      <button class="btn primary" bindtap="downloadWorkImage"><view class="download-glyph">↓</view>下载图片</button>
    </view>
  </view>

  <view wx:if="{{showWorkImageViewer && currentWork}}" class="modal-mask work-image-viewer" catchtap="closeWorkImageViewer">
    <button class="modal-close viewer-close" bindtap="closeWorkImageViewer" aria-label="关闭">×</button>
    <image class="viewer-image" src="{{currentWork.previewPath}}" mode="aspectFit" catchtap="stopPropagation" />
  </view>

  <!-- 底部导航：常驻（创作页不消失） -->
  <view wx:if="{{mode === 'home' || mode === 'portfolio' || mode === 'inspiration' || mode === 'recognition' || mode === 'scene'}}" class="bottom-nav" aria-label="{{brand.shopName}}导航">
    <button wx:for="{{navItems}}" wx:key="id" class="nav-item {{item.active ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeTab">
      <view class="nav-icon nav-{{item.glyph}}"></view>
      <text>{{item.label}}</text>
    </button>
  </view>

  <canvas id="export-canvas" type="2d" class="export-canvas" aria-hidden="true"></canvas>
</view>
